{
  "policy-docs": {
    "raw_tools_list": [
      {
        "name": "search_policy_documents",
        "description": "Search the claims policy documents.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "What to look up, e.g. the covered event or limit."
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "get_policy",
        "description": "Return the policy record for one policy number, POL-YYYY-nnnnn.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "policy_number": {
              "type": "string",
              "description": "The policy number, e.g. 'POL-2024-88120'."
            }
          },
          "required": [
            "policy_number"
          ]
        }
      }
    ]
  }
}